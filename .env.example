# ==============================================================================
# Valanze B2B — Variables de Entorno Requeridas
# Copia este archivo como .env para desarrollo local o agrégalas en Vercel
# ==============================================================================

# 1. Credenciales de Telegram (Obtenidas vía @BotFather)
TELEGRAM_BOT_TOKEN=tu-bot-token-aqui
TELEGRAM_SECRET_TOKEN=tu-secreto-aleatorio-para-proteger-el-webhook

# 2. Base de Datos en la Nube (Obtenidas de Supabase -> Project Settings -> API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-supabase-anon-key

# 3. ID de Telegram del Dueño / Administrador Principal
# (Puedes obtener tu ID numérico enviando un mensaje a @userinfobot en Telegram)
ADMIN_TELEGRAM_ID=123456789
